{
  "name": "react-native-network-activity",
  "version": "1.3.0",
  "description": "Network monitoring tool for React Native - Terminal UI similar to browser DevTools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "react-native-network-activity": "bin/monitor.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "network",
    "debugging",
    "monitor",
    "devtools",
    "fetch",
    "xhr",
    "http",
    "terminal",
    "cli"
  ],
  "author": "vrush-123",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrush-123/react-native-network-activity.git"
  },
  "bugs": {
    "url": "https://github.com/vrush-123/react-native-network-activity/issues"
  },
  "homepage": "https://github.com/vrush-123/react-native-network-activity#readme"
}
